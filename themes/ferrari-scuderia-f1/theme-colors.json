    "editor.tokenColorCustomizations": {
        "[Default Dark+]": {
            "comments": "#6A5555",
            "keywords": "#FF2020",
            "strings": "#FFB800",
            "numbers": "#FFEE00",
            "types": "#FF6B20",
            "functions": "#FF4444",
            "variables": "#CCAA99",
            "textMateRules": [
                {
                    "scope": ["keyword.control.flow.python", "keyword.control.import.python", "keyword.control.from.python"],
                    "settings": { "foreground": "#FF2020", "fontStyle": "bold" }
                },
                {
                    "scope": ["keyword.operator.logical.python", "keyword.operator.comparison.python", "keyword.operator.assignment.python", "keyword.operator.arithmetic.python"],
                    "settings": { "foreground": "#AA7777" }
                },
                {
                    "scope": ["keyword.operator", "keyword.operator.python"],
                    "settings": { "foreground": "#AA7777" }
                },
                {
                    "scope": ["keyword", "keyword.control", "storage", "storage.type"],
                    "settings": { "foreground": "#FF2020", "fontStyle": "bold" }
                },
                {
                    "scope": ["storage.type.function.python", "storage.type.class.python"],
                    "settings": { "foreground": "#FF2020", "fontStyle": "bold" }
                },
                {
                    "scope": ["entity.name.function.python", "entity.name.function"],
                    "settings": { "foreground": "#FF4444", "fontStyle": "bold" }
                },
                {
                    "scope": ["meta.function-call.generic.python", "meta.function-call.python"],
                    "settings": { "foreground": "#FF4444" }
                },
                {
                    "scope": ["support.function.builtin.python", "support.function"],
                    "settings": { "foreground": "#FF8844", "fontStyle": "bold" }
                },
                {
                    "scope": ["entity.name.function.decorator.python", "meta.function.decorator.python"],
                    "settings": { "foreground": "#FFA000", "fontStyle": "italic bold" }
                },
                {
                    "scope": ["entity.name.type.class.python", "entity.name.type"],
                    "settings": { "foreground": "#FF6B20", "fontStyle": "bold" }
                },
                {
                    "scope": ["support.type.python", "support.class.python"],
                    "settings": { "foreground": "#FF6B20" }
                },
                {
                    "scope": ["variable.parameter.function.language.python", "variable.parameter"],
                    "settings": { "foreground": "#CCAA99" }
                },
                {
                    "scope": ["variable.other.readwrite", "variable.other", "variable"],
                    "settings": { "foreground": "#CCAA99" }
                },
                {
                    "scope": ["variable.language.self.python", "variable.language.special.self.python", "variable.language"],
                    "settings": { "foreground": "#FF1744", "fontStyle": "italic" }
                },
                {
                    "scope": ["constant.numeric.integer.python", "constant.numeric.float.python", "constant.numeric"],
                    "settings": { "foreground": "#FFEE00" }
                },
                {
                    "scope": ["constant.language.python", "constant.language"],
                    "settings": { "foreground": "#FF1744", "fontStyle": "bold" }
                },
                {
                    "scope": ["string.quoted.single.python", "string.quoted.double.python", "string.quoted.docstring.multi.python", "string", "string.quoted"],
                    "settings": { "foreground": "#FFB800" }
                },
                {
                    "scope": ["string.interpolated", "constant.character.format.placeholder", "constant.other.placeholder"],
                    "settings": { "foreground": "#FFCC44" }
                },
                {
                    "scope": ["comment.line.number-sign.python", "comment", "punctuation.definition.comment"],
                    "settings": { "foreground": "#6A5555", "fontStyle": "italic" }
                },
                {
                    "scope": ["punctuation.definition.list.begin.python", "punctuation.definition.list.end.python", "punctuation.parenthesis.begin.python", "punctuation.parenthesis.end.python", "punctuation.definition.dict.begin.python", "punctuation.definition.dict.end.python"],
                    "settings": { "foreground": "#CC8866" }
                },
                {
                    "scope": ["punctuation.separator.comma.python", "punctuation.separator", "punctuation.separator.dict.python", "punctuation.separator.colon.python"],
                    "settings": { "foreground": "#AA7777" }
                },
                {
                    "scope": ["punctuation"],
                    "settings": { "foreground": "#AA7777" }
                },
                {
                    "scope": ["source.python"],
                    "settings": { "foreground": "#CCAA99" }
                },
                {
                    "scope": ["entity.name.tag", "entity.other.attribute-name"],
                    "settings": { "foreground": "#FF2020", "fontStyle": "bold" }
                },
                {
                    "scope": ["support.type.property-name", "entity.name.tag.css"],
                    "settings": { "foreground": "#CC8866" }
                },
                {
                    "scope": ["markup.heading", "entity.name.section"],
                    "settings": { "foreground": "#FF2020", "fontStyle": "bold" }
                },
                {
                    "scope": ["markup.bold"],
                    "settings": { "foreground": "#FFFFFF", "fontStyle": "bold" }
                },
                {
                    "scope": ["markup.italic"],
                    "settings": { "foreground": "#FF6B20", "fontStyle": "italic" }
                },
                {
                    "scope": ["markup.inline.raw", "markup.fenced_code.block"],
                    "settings": { "foreground": "#FFB800" }
                },
                {
                    "scope": ["keyword.other.DML.sql", "keyword.other.DDL.sql", "keyword.other.sql"],
                    "settings": { "foreground": "#FF2020", "fontStyle": "bold" }
                },
                {
                    "scope": ["constant.other.database-name.sql", "constant.other.table-name.sql"],
                    "settings": { "foreground": "#FFFFFF" }
                }
            ]
        }
    },
    "material-icon-theme.folders.color": "#FF2020",
    "powermode.explosions.customCss": {
        "filter": "drop-shadow(0 0 4px rgba(255, 68, 68, 0.9)) drop-shadow(0 0 10px rgba(255, 32, 32, 0.5))"
    }
